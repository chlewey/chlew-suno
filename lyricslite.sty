% lyricslite.sty - shared setup for notes-only ("lite") songbooks:
% song titles, tags, notes/style/prompt and plainly formatted lyrics.
\ProvidesPackage{lyricslite}[2026/10/20 v1 Lite songbook macros]

\RequirePackage{comment}
\RequirePackage{fontspec}
\RequirePackage{polyglossia}
\RequirePackage{imakeidx}
\RequirePackage{wasysym}

\setdefaultlanguage{english}
\setotherlanguage{arabic}
\setotherlanguage{japanese}
\setotherlanguage{korean}
\setmainfont{Noto Sans}
%\setmonofont{Noto Mono}
\newfontfamily\lyricsfont{Noto Serif}
\newfontfamily\arabicfont[
  Script=Arabic,
  Scale=MatchLowercase
]{Noto Naskh Arabic}
\newfontfamily\arabicfontsf[
  Script=Arabic,
  Scale=MatchLowercase
]{Noto Sans Arabic}
\newfontfamily\japanesefont[
  Script=Kana,
  Scale=MatchLowercase
]{Yu Gothic}
\newfontfamily\koreanfont[
  Scale=MatchLowercase
]{Malgun Gothic}

\makeindex[name=tags,title={Index of tags}]
\makeindex[name=songs,title={Index of songs}]
\setsecnumdepth{none}

\newcommand\songtitle[1]{\section{#1}\index[songs]{#1}}
\newcommand\annotation[1]{\texttt{\footnotesize[#1]}}
\newcommand\songpart[1]{\par\textbf{[#1]}\par}
\newcommand\sepbar{~\par{\centering\rule{.5\textwidth}{.5pt}\par}}

% \tagexclude{tag1,tag2,...} -- blacklist tags so \tag/\tag* skip both
% the typeset marker and the index entry for them.
\newcommand\tagexclude[1]{%
\@for\tag@excl@tmp:=#1\do{%
\expandafter\gdef\csname tag@excl@\tag@excl@tmp\endcsname{}%
}%
}
\newcommand\tag{\@ifstar\tag@star\tag@nostar}
\newcommand\tag@nostar[2][\@empty]{%
\@ifundefined{tag@excl@#2}{%
\texttt{\,\footnotesize\textbf{\##2}\,}%
\index[tags]{#2}%
\ifx\@empty#1\relax\else\index[#1]{#2}\fi
}{}%
}
\newcommand\tag@star[1]{%
\@ifundefined{tag@excl@#1}{%
\texttt{\,\footnotesize\textbf{\##1}\,}%
}{}%
}

% Minimal lyrics layout: stanzas as unindented paragraphs. The optional
% width argument is accepted for compatibility with chlewrics and ignored.
% A notes-only book hides lyrics with \excludecomment{lyrics}.
\newenvironment{lyrics}[1][]{%
\subsection*{Lyrics}%
\setlength{\parindent}{0pt}%
\setlength{\parskip}{0.6\baselineskip}%
}{\par}
\newenvironment{notes}{\subsection*{Notes}}{}
\newenvironment{style}{\subsection*{Style}}{}
\newenvironment{prompt}{\subsection*{Prompt}}{}
